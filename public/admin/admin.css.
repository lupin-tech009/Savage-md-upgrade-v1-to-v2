
:root {
  color-scheme: dark;
  --background: #080808;
  --surface: #111111;
  --surface-light: #191919;
  --border: #292929;
  --red: #e50914;
  --red-dark: #a80710;
  --text: #f5f5f5;
  --muted: #999999;
  --success: #28c76f;
  --warning: #ffb020;
  --danger: #ff4d4f;
  --radius: 14px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, #26090c 0, transparent 35%),
    var(--background);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.5;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

[hidden] {
  display: none !important;
}

.admin-shell {
  width: min(1200px, 94%);
  margin: 0 auto;
  padding: 24px 0;
}

.admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 0 24px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 30px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 13px;
  background: linear-gradient(145deg, var(--red), #650008);
  font-size: 25px;
  font-weight: 900;
}

.brand h1 {
  font-size: 19px;
  letter-spacing: 1px;
}

.brand h1 span {
  color: var(--red);
}

.brand p {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 2px;
}

.panel {
  padding: 24px;
  background: rgba(17, 17, 17, 0.96);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 22px;
}

.panel h2 {
  margin-bottom: 8px;
  font-size: 21px;
}

.muted {
  color: var(--muted);
  font-size: 13px;
}

.login-panel {
  width: min(440px, 100%);
  margin: 60px auto;
}

.login-panel form {
  display: flex;
  flex-direction: column;
  gap: 11px;
  margin-top: 24px;
}

label {
  color: #dddddd;
  font-size: 13px;
  font-weight: 600;
}

input {
  width: 100%;
  min-height: 45px;
  padding: 11px 13px;
  background: #080808;
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 9px;
  outline: none;
}

input:focus {
  border-color: var(--red);
  box-shadow: 0 0 0 2px rgba(229, 9, 20, 0.12);
}

.primary-button,
.secondary-button,
.logout-button {
  min-height: 42px;
  padding: 10px 17px;
  border-radius: 9px;
  font-weight: 700;
  transition: 0.2s ease;
}

.primary-button {
  color: white;
  background: var(--red);
  border: 1px solid var(--red);
}

.primary-button:hover {
  background: var(--red-dark);
}

.secondary-button {
  color: white;
  background: var(--surface-light);
  border: 1px solid #383838;
}

.secondary-button:hover {
  border-color: var(--red);
  color: #ff6b73;
}

.logout-button {
  color: #ff777d;
  background: transparent;
  border: 1px solid #722027;
}

.welcome-row,
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.statistics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 25px;
}

.stat-card {
  padding: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.stat-card span {
  display: block;
  color: var(--muted);
  font-size: 12px;
  margin-bottom: 9px;
}

.stat-card strong {
  font-size: 27px;
  color: white;
}

.search-row {
  display: flex;
  gap: 10px;
  margin: 20px 0;
}

.search-row input {
  flex: 1;
  min-width: 0;
}

.table-wrapper {
  width: 100%;
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 10px;
}

table {
  width: 100%;
  min-width: 760px;
  border-collapse: collapse;
  text-align: left;
}

th,
td {
  padding: 14px 13px;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
  white-space: nowrap;
}

th {
  color: #ff747b;
  background: #191010;
  font-weight: 700;
}

td {
  color: #dddddd;
}

tbody tr:hover {
  background: #191919;
}

tbody tr:last-child td {
  border-bottom: none;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 17px;
  margin: 22px 0;
}

.details-grid div {
  padding: 14px;
  background: #090909;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow-wrap: anywhere;
}

.details-grid span {
  display: block;
  color: var(--muted);
  font-size: 11px;
  margin-bottom: 6px;
}

.details-grid strong {
  font-size: 14px;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 20px;
}

.key-panel {
  border-color: #6e1b22;
}

.key-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px;
  margin-top: 18px;
  background: #080808;
  border: 1px dashed #8b252d;
  border-radius: 10px;
}

.key-display code {
  color: #ff747b;
  overflow-wrap: anywhere;
  font-size: 14px;
}

.message {
  min-height: 20px;
  margin-top: 13px;
  color: var(--muted);
  font-size: 13px;
}

.message.error {
  color: var(--danger);
}

.message.success {
  color: var(--success);
}

footer {
  padding: 24px 0 10px;
  color: var(--muted);
  text-align: center;
  font-size: 11px;
}

footer p + p {
  margin-top: 4px;
}

@media (max-width: 850px) {
  .statistics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .details-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .admin-shell {
    width: 92%;
    padding-top: 12px;
  }

  .admin-header {
    margin-bottom: 20px;
  }

  .brand h1 {
    font-size: 16px;
  }

  .panel {
    padding: 17px;
  }

  .login-panel {
    margin: 35px auto;
  }

  .welcome-row,
  .section-heading {
    align-items: flex-start;
  }

  .statistics-grid {
    gap: 10px;
  }

  .stat-card {
    padding: 14px;
  }

  .stat-card strong {
    font-size: 23px;
  }

  .details-grid {
    grid-template-columns: 1fr;
  }

  .search-row {
    flex-direction: column;
  }

  .search-row button {
    width: 100%;
  }

  .action-row {
    flex-direction: column;
  }

  .action-row button {
    width: 100%;
  }

  .key-display {
    align-items: stretch;
    flex-direction: column;
  }

  .key-display button {
    width: 100%;
  }
}
