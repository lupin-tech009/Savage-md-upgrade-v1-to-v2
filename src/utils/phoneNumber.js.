
const DEFAULT_COUNTRY_CODE = '234';

export function normalizePhoneNumber(input) {
  if (typeof input !== 'string') {
    throw new Error('Phone number must be text.');
  }

  let number = input.trim().replace(/[\s\-().]/g, '');

  if (number.startsWith('+')) {
    number = number.slice(1);
  }

  if (number.startsWith('00')) {
    number = number.slice(2);
  }

  // Convert Nigerian local format to international format.
  if (number.startsWith('0')) {
    number = DEFAULT_COUNTRY_CODE + number.slice(1);
  } else if (
    !number.startsWith(DEFAULT_COUNTRY_CODE) &&
    number.length === 10
  ) {
    number = DEFAULT_COUNTRY_CODE + number;
  }

  if (!/^[1-9]\d{7,14}$/.test(number)) {
    throw new Error('Invalid international phone number.');
  }

  return number;
}

export function isValidPhoneNumber(input) {
  try {
    normalizePhoneNumber(input);
    return true;
  } catch {
    return false;
  }
}

export function areDifferentPhoneNumbers(first, second) {
  return normalizePhoneNumber(first) !==
    normalizePhoneNumber(second);
}
